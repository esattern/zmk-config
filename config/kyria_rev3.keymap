#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* Uncomment this block if using RGB
&led_strip {
    chain-length = <6>;
    // chain-length = <31>; // Uncomment if using both per-key and underglow LEDs
    // chain-length = <25>; // Uncomment if using only per-key LEDs.
};
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Default";
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  Q  |  W  |  E   |  R  |  T   |                                         |  Y   |  U  |  I  |  O  |  P  | BSPC  |
            // |  TAB  |  A  |  S  |  D   |  F  |  G   |                                         |  H   |  J  |  K  |  L  |  ;  |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V  |  B   | PREV  | VOL-DN  |     | VOL-UP  | NEXT  |  N   |  M  |  ,  |  .  |  /  | SHIFT |
            //                     | GUI  | ALT | CTRL | SPACE | LAYER 1 |     | LAYER 2 | ENTER | CTRL | ALT | GUI |
            bindings = <
            &kp ESC   &kp Q &kp W &kp E &kp R &kp T                                                 &kp Y &kp U &kp I &kp O &kp P &kp BSPC
            &kp TAB   &kp A &kp S &kp D &kp F &kp G                                                 &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
            &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp C_PREV &kp C_VOL_DN      &kp C_VOL_UP &kp C_NEXT &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                  &kp LGUI &kp LALT &kp LCTRL &kp SPACE &mo 1    &mo 2 &kp ENTER &kp RCTRL &kp RALT &kp RGUI
            >;

            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
        numeric_layer { // Layer 1
            display-name = "Numerics & Symbols";
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |      |  `   |  ~   |  \   |  |   |      |                                        |  :   |  7   |  8   |  9   | DEL  |      |
            // |      |  {   |  }   |  (   |  )   |      |                                        |  +   |  4   |  5   |  6   |  *   |  =   |
            // |      |  [   |  ]   |  <   |  >   |      |      |      |            |      |      |  -   |  1   |  2   |  3   |  /   |      |
            //                      |      |      |      |      |      |            |      |      |  0   |  ,   |  .   |
            bindings = <
            &trans &kp GRAVE &kp TILDE &kp BSLH &kp PIPE &trans                              &kp COLON &kp N7 &kp N8 &kp N9 &kp DEL &trans
            &trans &kp LBRC &kp RBRC &kp LPAR &kp RPAR &trans                                &kp PLUS &kp N4 &kp N5 &kp N6 &kp ASTERISK &kp EQUAL
            &trans &kp LBKT &kp RBKT &kp LT &kp GT &trans &trans &trans        &trans &trans &kp MINUS &kp N1 &kp N2 &kp N3 &kp FSLH &trans
                            &trans &trans &trans &trans &trans                 &trans &trans &kp N0 &kp COMMA &kp DOT
            >;
        };
        navigation_layer { // Layer 2
            display-name = "Navigation & Function";
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |      |  F1  |  F2  |  F3  |  F4  |  F5  |                                        | PGUP |      |  UP  |      | DEL  |      |
            // |      |  F6  |  F7  |  F8  |  F9  |  F10 |                                        | PGDN | LEFT | DOWN | RIGHT|      |      |
            // |      |      |      |      |  F11 |  F12 |      |      |            |      |      |      | HOME |      |  END |      |      |
            //                      |      |      |      |      |      |            |      |      |      |      |      |
            bindings = <
            &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                                      &kp PG_UP &trans &kp UP &trans &kp DEL &trans
            &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10                                     &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans &trans
            &trans &trans &trans &trans &kp F11 &kp F12 &trans &trans        &trans &trans &trans &kp HOME &trans &kp END &trans &trans
                                 &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans
            >;
        };
        special_layer { // Layer 3
            display-name = "Special";
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |      |BTSEL0|BTSEL1|BTSEL2|BTSEL3|BTSEL4|                                        |      |      |      |      |      |      |
            // |      |      |      |      |      |      |                                        |      |      |      |      |      |      |
            // |      |      |      |      |      |      |BT_CLR|      |            |      |      |      |      |      |      |      |      |
            //                      |      |      |      |      |      |            |      |      |      |      | TO4  |
            bindings = <
            &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4              &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans                                            &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &bt BT_CLR &trans            &trans &trans &trans &trans &trans &trans &trans &trans
                                 &trans &trans &trans &trans &trans                &trans &trans &trans &trans &to 4
            >;
        };
        gaming_layer { // Layer 4
            display-name = "Gaming";
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |      |  T   |  Q   |  W   |  E   |  R   |                                        |      |      |      |      |      |      |
            // |      |  G   |  A   |  S   |  D   |  F   |                                        |      |      |      |      |      |      |
            // |      |  B   |  Z   |  X   |  C   |  V   |      |      |            |      |      |      |      |      |      |      |      |
            //                      |      |      |      |      |      |            |      |      |      |      | TO0  |
            bindings = <
            &trans &kp T &kp Q &kp W &kp E &kp R                                         &trans &trans &trans &trans &trans &trans
            &trans &kp G &kp A &kp S &kp D &kp F                                         &trans &trans &trans &trans &trans &trans
            &trans &kp B &kp Z &kp X &kp C &kp V &trans &trans             &trans &trans &trans &trans &trans &trans &trans &trans
                               &trans &trans &trans &trans &trans          &trans &trans &trans &trans &to 0
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
